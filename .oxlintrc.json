{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true
  },
  "ignorePatterns": ["dist", "temp", "shots", "node_modules", ".qoder", "*.md"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "unicorn/no-useless-spread": "warn",
    "unicorn/no-useless-fallback-in-spread": "warn",
    "unicorn/no-single-promise-in-promise-methods": "warn",
    "unicorn/prefer-string-starts-ends-with": "warn",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@/router",
            "message": "勿从 router 外部 import 路由 index：它会拉进 guard → store → api，形成 request → router → guard → store → api → request 循环依赖（AGENTS §4.2）。要 router 实例用 @/router/core/bridge，要动态路由挂接/清理用 @/router/core/dynamicRoutes —— 只有这两个是叶模块。"
          },
          {
            "name": "@/router/index",
            "message": "同上：用 @/router/core/bridge 或 @/router/core/dynamicRoutes（叶模块），或由 main.ts 走相对路径 ./router。"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/lib/primeLcmgr.ts"],
      "rules": {
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["src/main.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
