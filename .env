# 网络层模式：true=进程内 mock adapter（读写 localStorage，默认）；false=真实后端（请求走 vite dev proxy）
VITE_USE_MOCK=false
# 真实后端地址：仅 VITE_USE_MOCK=false 时生效（vite.config.ts 的 server.proxy target）
VITE_API_TARGET=http://192.168.60.213:5229


# 共用基础配置（所有环境共享）
VITE_BASE_URL = /
VITE_API_URL_PREFIX = /api

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=hmx-tdweb

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
VITE_APP_STORE_SECURE_KEY=5432167890

# 路由命名空间，用于路由的命名，确保隔离
VITE_ROUTER_NAMESPACE=TDWEB
VITE_MOBILE_ROUTER_NAMESPACE=TDMOB

VITE_APP_NAME = "邢台铁特钢贸系统"
VITE_CUSTOMER = "邢台铁特新材料有限公司"
VITE_COPYRIGHT = "北京红谷软件技术有限公司"
